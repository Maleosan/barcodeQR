rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.email == __VITE_ADMIN_EMAIL_JSON__;
    }

    function isAdmin() {
      return isMainAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function validUserRole(role) {
      return role == 'user' || role == 'admin';
    }

    function validRequestStatus(status) {
      return status == 'none' || status == 'pending' || status == 'approved' || status == 'rejected';
    }

    function validOwnUserCreate(uid) {
      return signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        validUserRole(request.resource.data.role) &&
        validRequestStatus(request.resource.data.adminRequestStatus) &&
        (
          (isMainAdmin() && request.resource.data.role == 'admin' && request.resource.data.primaryAdmin == true && request.resource.data.adminRequestStatus == 'approved') ||
          (!isMainAdmin() && request.resource.data.role == 'user' && request.resource.data.primaryAdmin == false && request.resource.data.adminRequestStatus in ['none', 'pending'])
        );
    }

    function safeOwnUserUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        (
          (resource.data.primaryAdmin == true && request.resource.data.primaryAdmin == true) ||
          (resource.data.primaryAdmin != true && request.resource.data.primaryAdmin == false)
        ) &&
        changed.hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'adminRequest', 'adminRequestStatus', 'adminRequestedAt']) &&
        validRequestStatus(request.resource.data.adminRequestStatus) &&
        (
          !changed.hasAny(['adminRequest', 'adminRequestStatus', 'adminRequestedAt']) ||
          (
            request.resource.data.adminRequestStatus != 'approved' &&
            (request.resource.data.adminRequestStatus != 'pending' || request.resource.data.adminRequest == true)
          )
        );
    }

    function protectsMainAdmin() {
      return resource.data.primaryAdmin != true ||
        (request.resource.data.role == 'admin' && request.resource.data.primaryAdmin == true && request.resource.data.adminRequestStatus == 'approved');
    }

    function validPrimaryAdminSelfUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isMainAdmin() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == 'admin' &&
        request.resource.data.primaryAdmin == true &&
        request.resource.data.adminRequest == false &&
        request.resource.data.adminRequestStatus == 'approved' &&
        changed.hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'role', 'primaryAdmin', 'adminRequest', 'adminRequestStatus']);
    }

    function validAdminUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        (
          (resource.data.primaryAdmin == true && request.resource.data.primaryAdmin == true) ||
          (resource.data.primaryAdmin != true && request.resource.data.primaryAdmin == false)
        ) &&
        changed.hasOnly(['role', 'adminRequest', 'adminRequestStatus', 'adminResolvedAt', 'adminResolvedBy']) &&
        validUserRole(request.resource.data.role) &&
        validRequestStatus(request.resource.data.adminRequestStatus) &&
        protectsMainAdmin();
    }

    function validBarang() {
      return request.resource.data.keys().hasAll([
        'kodeBarang', 'namaBarang', 'kategori', 'satuan', 'stok',
        'stokMinimum', 'lokasi', 'createdAt', 'updatedAt', 'updatedBy'
      ]) &&
      request.resource.data.kodeBarang is string &&
      request.resource.data.namaBarang is string &&
      request.resource.data.stok is number && request.resource.data.stok >= 0 &&
      request.resource.data.stokMinimum is number && request.resource.data.stokMinimum >= 0 &&
      request.resource.data.harga is number && request.resource.data.harga >= 0 &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      request.resource.data.updatedBy == request.auth.uid;
    }

    function validAtomicStockUpdate(itemId) {
      return request.resource.data.stok == resource.data.stok || (
        request.resource.data.lastTransactionId is string &&
        !exists(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)) &&
        existsAfter(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)) &&
        getAfter(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)).data.itemId == itemId &&
        getAfter(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)).data.stokSebelum == resource.data.stok &&
        getAfter(/databases/$(database)/documents/transaksi/$(request.resource.data.lastTransactionId)).data.stokSesudah == request.resource.data.stok
      );
    }

    function validTransaction(transactionId) {
      return request.resource.data.keys().hasAll([
        'id', 'itemId', 'kodeBarang', 'namaBarang', 'jenis', 'jumlah',
        'stokSebelum', 'stokSesudah', 'userId', 'userName',
        'userEmail', 'timestamp', 'keterangan'
      ]) &&
      request.resource.data.id == transactionId &&
      request.resource.data.kodeBarang is string &&
      request.resource.data.namaBarang is string &&
      request.resource.data.userId == request.auth.uid &&
      request.resource.data.userEmail == request.auth.token.email &&
      request.resource.data.userName is string &&
      request.resource.data.timestamp is timestamp &&
      request.resource.data.keterangan is string &&
      request.resource.data.jenis in ['TAMBAH', 'KURANG', 'STOK_OPNAME', 'PENYESUAIAN'] &&
      request.resource.data.jumlah is number &&
      request.resource.data.stokSebelum is number &&
      request.resource.data.stokSesudah is number && request.resource.data.stokSesudah >= 0 &&
      (
        (request.resource.data.jenis == 'TAMBAH' && request.resource.data.jumlah > 0 && request.resource.data.stokSesudah == request.resource.data.stokSebelum + request.resource.data.jumlah) ||
        (request.resource.data.jenis == 'KURANG' && request.resource.data.jumlah > 0 && request.resource.data.stokSesudah == request.resource.data.stokSebelum - request.resource.data.jumlah) ||
        request.resource.data.jenis == 'PENYESUAIAN' ||
        (
          request.resource.data.jenis == 'STOK_OPNAME' &&
          request.resource.data.keys().hasAll(['jumlahFisik', 'selisih']) &&
          request.resource.data.jumlahFisik is number && request.resource.data.jumlahFisik >= 0 &&
          request.resource.data.selisih == request.resource.data.jumlahFisik - request.resource.data.stokSebelum &&
          request.resource.data.jumlah == request.resource.data.selisih &&
          request.resource.data.stokSesudah == request.resource.data.jumlahFisik
        )
      );
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if validOwnUserCreate(uid);
      allow update: if validPrimaryAdminSelfUpdate(uid) || validAdminUserUpdate() || safeOwnUserUpdate(uid);
      allow delete: if isAdmin() && resource.data.primaryAdmin != true;
    }

    match /barang/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && validBarang();
      allow update: if signedIn() && validBarang() && validAtomicStockUpdate(itemId);
      allow delete: if signedIn();
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.lastSeenAt is timestamp &&
        request.resource.data.keys().hasOnly(['uid', 'lastSeenAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /transaksi/{transactionId} {
      allow read: if signedIn();
      allow create: if signedIn() && validTransaction(transactionId);
      allow update, delete: if isAdmin();
    }
  }
}
